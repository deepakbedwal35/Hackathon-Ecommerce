# Application environment (development, test, production)
APP_ENV=development

# Database connection URL (PostgreSQL 16 via psycopg3)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecommerce_db

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_placeholder

# LLM Provider API Key
LLM_API_KEY=your_llm_api_key_placeholder

# CORS Allowed Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Local Docker Compose PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432
